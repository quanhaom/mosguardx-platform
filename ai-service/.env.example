APP_NAME=MosGuardX AI API
APP_VERSION=1.2.1-beta
APP_ENVIRONMENT=production

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
OBSERVATION_BUCKET=mosguardx-observations

MODEL_PATH=models/mosguardx_best.pt
MODEL_VERSION=mosguardx-yolo11n-det-v1
MODEL_STORAGE_BUCKET=mosguardx-models
MODEL_STORAGE_PATH=mosguardx_best.pt
IMAGE_SIZE=640
CONFIDENCE_THRESHOLD=0.35
IOU_THRESHOLD=0.45

CLASSIFIER_ENABLED=true
CLASSIFIER_REQUIRED=true
CLASSIFIER_PATH=models/worker_c_best.pt
CLASSIFIER_MODEL_VERSION=worker-c-yolo11s-cls-img384-seed2026
CLASSIFIER_STORAGE_BUCKET=mosguardx-models
CLASSIFIER_STORAGE_PATH=worker_c/best.pt
CLASSIFIER_IMAGE_SIZE=384
CLASSIFIER_BATCH_SIZE=8
CLASSIFIER_REVIEW_THRESHOLD=0.65
CLASSIFIER_ALWAYS_REVIEW_SPECIES=aegypti

MAX_UPLOAD_MB=10
SIGNED_URL_TTL_SECONDS=3600
ALERT_COUNT_THRESHOLD=10
ADMIN_API_KEY=REPLACE_WITH_A_LONG_RANDOM_VALUE
CORS_ORIGINS=http://localhost:3000,https://mosguardx-platform.vercel.app
